{
	"name": "lexcontent",
	"version": "0.1.0",
	"description": "Standalone HTML main-content extraction (boilerplate removal) and Markdown rendering on a vendored, statically-linked Lexbor HTML5 parser -- zero scrubbed dependency.",
	"authors": ["Shammah Chancellor"],
	"copyright": "Copyright © 2026, Shammah Chancellor",
	"license": "MIT",
	"targetType": "library",
	"sourcePaths": ["source"],
	"importPaths": ["source"],
	"dependencies": {
		"lexbor-d": { "path": "../lexbor-d" }
	},
	"dflags": ["-preview=dip1000"],
	"buildTypes": {
		"release": {
			"buildOptions": ["releaseMode", "optimize", "inline"]
		},
		"release-unittest": {
			"buildOptions": ["unittests", "releaseMode", "optimize", "inline"]
		}
	}
}
