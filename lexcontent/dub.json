{
	"name": "lexcontent",
	"version": "0.1.0",
	"description": "Standalone HTML main-content extraction (boilerplate removal) and Markdown rendering on a vendored, statically-linked Lexbor HTML5 parser -- zero scrubbed dependency.",
	"authors": ["Shammah Chancellor"],
	"copyright": "Copyright © 2026, Shammah Chancellor",
	"license": "MIT",
	"targetType": "library",
	"sourcePaths": ["source"],
	"importPaths": ["source"],
	"preBuildCommands": [
		"cmake -S third_party/lexbor -B .dub/lexbor -DLEXBOR_BUILD_SHARED=OFF -DLEXBOR_BUILD_STATIC=ON -DLEXBOR_BUILD_TESTS=OFF -DLEXBOR_BUILD_EXAMPLES=OFF -DLEXBOR_BUILD_BENCHMARKS=OFF -DLEXBOR_BUILD_UTILS=OFF -DLEXBOR_BUILD_SEPARATELY=OFF",
		"cmake --build .dub/lexbor --target lexbor_static -j4"
	],
	"sourceFiles": [".dub/lexbor/liblexbor_static.a"],
	"dflags": ["-preview=dip1000"],
	"buildTypes": {
		"release": {
			"buildOptions": ["releaseMode", "optimize", "inline"]
		},
		"release-unittest": {
			"buildOptions": ["unittests", "releaseMode", "optimize", "inline"]
		}
	}
}
