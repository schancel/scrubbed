{
	"name": "s3lite",
	"description": "Minimal, zero-dependency pure-D S3 client (GetObject/PutObject/ListObjectsV2). A streaming @nogc nothrow core -- uploads from a range, downloads into a sink, listings through a callback, caller-supplied memory -- over a swappable transport (libcurl FFI), plus a whole-buffer convenience layer and worker-pool bulk transfer.",
	"authors": ["Shammah Chancellor"],
	"license": "MIT",
	"copyright": "Copyright © 2026, Shammah Chancellor",
	"targetType": "library",
	"sourcePaths": ["source"],
	"importPaths": ["source"],
	"dflags": ["-preview=dip1000"],
	"libs": ["curl"],
	"configurations": [
		{
			"name": "library",
			"targetType": "library"
		},
		{
			"name": "sigv4-fixtures",
			"targetType": "executable",
			"targetName": "sigv4-fixtures",
			"mainSourceFile": "tests/sigv4_fixtures.d"
		},
		{
			"name": "loopback-fixture",
			"targetType": "executable",
			"targetName": "loopback-fixture",
			"mainSourceFile": "tests/loopback_fixture.d"
		},
		{
			"name": "put-list-loopback-fixture",
			"targetType": "executable",
			"targetName": "put-list-loopback-fixture",
			"mainSourceFile": "tests/put_list_loopback_fixture.d"
		},
		{
			"name": "transfer-bulk-fixture",
			"targetType": "executable",
			"targetName": "transfer-bulk-fixture",
			"mainSourceFile": "tests/transfer_bulk_fixture.d"
		},
		{
			"name": "streaming-loopback-fixture",
			"targetType": "executable",
			"targetName": "streaming-loopback-fixture",
			"mainSourceFile": "tests/streaming_loopback_fixture.d",
			"sourceFiles": ["tests/loopback_server.d"]
		},
		{
			"name": "large-object-memory-fixture",
			"targetType": "executable",
