{
	"name": "scrubbed",
	"description": "Text sanitization CLI in D: mojibake repair + normalization filters, range-based pipeline, parallel multi-document processing",
	"authors": ["Shammah Chancellor"],
	"license": "MIT",
	"targetType": "executable",
	"sourcePaths": ["source"],
	"dependencies": {"argparse": "==2.0.2"},
	"preBuildCommands": ["cc -O2 -DSQLITE_THREADSAFE=1 -DSQLITE_OMIT_LOAD_EXTENSION -c third_party/sqlite/sqlite3.c -o third_party/sqlite/sqlite3.o"],
	"sourceFiles": ["third_party/sqlite/sqlite3.o"],
	"dflags": ["-g"],
	"buildTypes": {
		"release": {
			"buildOptions": ["releaseMode", "optimize", "inline"]
		}
	}
}
