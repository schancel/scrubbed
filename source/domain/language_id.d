version (unittest) {
    import domain.document : SourceLocator;

    private DocumentId testDocumentId() {
        return DocumentId.from(SourceLocator("language-id-unit", "source", "doc-1"));
    }
}

unittest {
    assert(detectLanguage([]).reason == LanguageAbstentionReason.emptyText);
    auto oversized = new ubyte[maxLanguageIdTextBytes + 1];
    oversized[] = cast(ubyte) 'a';
    assert(detectLanguage(oversized).reason == LanguageAbstentionReason.oversizeText);
    ubyte[3] invalid = [0xff, 0xfe, 0xfd];
    assert(detectLanguage(invalid[]).reason == LanguageAbstentionReason.invalidUtf8);
}

unittest {
    auto id = testDocumentId();
    auto text = cast(const(ubyte)[]) "This is a short but plain example sentence for testing purposes today.";
    auto record = buildLanguageIdentity(id, text);
    auto encoded = encodeLanguageIdentity(record);
    auto decoded = decodeLanguageIdentity(encoded, id, record.identity.textRevision);
    assert(decoded == record);
    assert(encodeLanguageIdentity(decoded) == encoded);

    auto otherId = DocumentId.from(SourceLocator("language-id-unit", "source", "doc-2"));
    bool rejected;
    try decodeLanguageIdentity(encoded, otherId, record.identity.textRevision);
    catch (Exception) rejected = true;
    assert(rejected);
}

unittest {
    // routeLanguage never routes an abstained result, and only routes a
    // detected result at or above the caller-supplied threshold.
    LanguageDetectionResult detected;
    detected.status = LanguageDetectionStatus.detected;
    detected.language = SupportedLanguage.fr;
    detected.confidence = 0.5;
    assert(routeLanguage(detected, 0.5f).routed);
    assert(routeLanguage(detected, 0.6f).routed == false);
    assert(routeLanguage(abstain(LanguageAbstentionReason.tooShort), 0.0f).routed == false);
}

unittest {
    // Required fix #2 boundary proof: isBrahmicLetter's 6 ranges must not
    // creep into the immediately adjacent, explicitly out-of-scope Oriya
    // (0x0B00-0x0B7F) or Kannada (0x0C80-0x0CFF) blocks. Tested directly at
    // and just past each boundary, since isBrahmicLetter is private to this
    // module.
    // Gurmukhi/Gujarati end just before Oriya starts.
    assert(isBrahmicLetter(0x0AFF)); // Gujarati: last code point in range
    assert(!isBrahmicLetter(0x0B00)); // Oriya start: must NOT be admitted
    assert(!isBrahmicLetter(0x0B7F)); // Oriya end: must NOT be admitted
    assert(isBrahmicLetter(0x0B80)); // Tamil: first code point in range
    // Telugu ends just before Kannada starts.
    assert(isBrahmicLetter(0x0C7F)); // Telugu: last code point in range
    assert(!isBrahmicLetter(0x0C80)); // Kannada start: must NOT be admitted
    assert(!isBrahmicLetter(0x0CFF)); // Kannada end: must NOT be admitted
    // Each recognized script's own range boundaries, both ends.
    assert(isBrahmicLetter(0x0900) && isBrahmicLetter(0x097F)); // Devanagari
    assert(isBrahmicLetter(0x0980) && isBrahmicLetter(0x09FF)); // Bengali
    assert(isBrahmicLetter(0x0A00) && isBrahmicLetter(0x0A7F)); // Gurmukhi
    assert(isBrahmicLetter(0x0A80) && isBrahmicLetter(0x0AFF)); // Gujarati
    assert(isBrahmicLetter(0x0B80) && isBrahmicLetter(0x0BFF)); // Tamil
    assert(isBrahmicLetter(0x0C00) && isBrahmicLetter(0x0C7F)); // Telugu
    // One code point just outside each end of the full recognized span.
    assert(!isBrahmicLetter(0x08FF));
    assert(!isBrahmicLetter(0x0D00));
}

unittest {
    // Required fix #1 direct proof: a conjunct-heavy (virama-joined) or
    // loanword-consonant (nukta-joined) word round-trips through wordsOf as
    // ONE word, not fragments. Constructed via explicit \u escapes so the
    // exact virama/nukta code points under test are unambiguous regardless
    // of source-file normalization. wordsOf is private, so this is tested
    // directly here rather than through the public API.
    // Hindi: क्षत्र (kṣatra) -- 2 viramas (U+094D); the contract's own example.
    auto kshatra = wordsOf("क्षत्र");
    assert(kshatra.length == 1 && kshatra[0].length == 6);
    // Hindi nukta loanword: ज़रूरी (zaroori, "necessary").
    auto zaroori = wordsOf("ज़रूरी");
    assert(zaroori.length == 1 && zaroori[0].length == 6);
    // Bengali: বিশ্ব (bishwa, "world") -- one virama (U+09CD).
    auto bishwa = wordsOf("বিশ্ব");
    assert(bishwa.length == 1 && bishwa[0].length == 5);
    // Bengali nukta: বড় (boro, "big").
    auto boro = wordsOf("বড়");
    assert(boro.length == 1 && boro[0].length == 3);
    // Gurmukhi: ਸ੍ਵਰ (swar, "vowel/tone") -- one virama (U+0A4D).
    auto swar = wordsOf("ਸ੍ਵਰ");
    assert(swar.length == 1 && swar[0].length == 4);
    // Gurmukhi nukta: ਜ਼ਰੂਰੀ (zaroori, "necessary").
    auto gurmukhiZaroori = wordsOf("ਜ਼ਰੂਰੀ");
    assert(gurmukhiZaroori.length == 1 && gurmukhiZaroori[0].length == 6);
    // Gujarati: વિશ્વ (vishwa, "world") -- one virama (U+0ACD).
    auto vishwa = wordsOf("વિશ્વ");
    assert(vishwa.length == 1 && vishwa[0].length == 5);
    // Gujarati nukta-joined consonant.
    auto gujaratiNukta = wordsOf("જ઼રૂરી");
    assert(gujaratiNukta.length == 1 && gujaratiNukta[0].length == 6);
    // Tamil: கல்வி (kalvi, "education") -- pulli/virama (U+0BCD); Tamil has
    // no nukta code point in Unicode, so there is no Tamil nukta case here.
    auto kalvi = wordsOf("கல்வி");
    assert(kalvi.length == 1 && kalvi[0].length == 5);
    // Telugu: విద్య (vidya, "education") -- virama (U+0C4D); Telugu also has
    // no nukta code point in Unicode.
    auto vidya = wordsOf("విద్య");
    assert(vidya.length == 1 && vidya[0].length == 5);
}
