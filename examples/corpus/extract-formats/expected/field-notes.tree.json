{"version":"tree-json:v1","documentId":"<DOCUMENT_ID>","source":{"namespace":"local-html:v1","sourceKey":"<SOURCE_KEY>","recordKey":"field-notes.html"},"outputName":"field-notes.html.tree.json","nodes":[{"kind":"element","parent":null,"name":"html","attributes":[{"name":"lang","value":"en"}],"text":""},{"kind":"element","parent":0,"name":"head","attributes":[],"text":""},{"kind":"text","parent":1,"name":"","attributes":[],"text":"\n"},{"kind":"element","parent":1,"name":"meta","attributes":[{"name":"charset","value":"utf-8"}],"text":""},{"kind":"text","parent":1,"name":"","attributes":[],"text":"\n"},{"kind":"element","parent":1,"name":"title","attributes":[],"text":""},{"kind":"text","parent":5,"name":"","attributes":[],"text":"Delta Survey Field Notes"},{"kind":"text","parent":1,"name":"","attributes":[],"text":"\n"},{"kind":"text","parent":0,"name":"","attributes":[],"text":"\n"},{"kind":"element","parent":0,"name":"body","attributes":[],"text":""},{"kind":"text","parent":9,"name":"","attributes":[],"text":"\n"},{"kind":"element","parent":9,"name":"header","attributes":[],"text":""},{"kind":"element","parent":11,"name":"nav","attributes":[],"text":""},{"kind":"text","parent":12,"name":"","attributes":[],"text":"Home About Contact"},{"kind":"text","parent":9,"name":"","attributes":[],"text":"\n"},{"kind":"element","parent":9,"name":"article","attributes":[],"text":""},{"kind":"text","parent":15,"name":"","attributes":[],"text":"\n"},{"kind":"element","parent":15,"name":"h1","attributes":[],"text":""},{"kind":"text","parent":17,"name":"","attributes":[],"text":"Delta Survey Field Notes"},{"kind":"text","parent":15,"name":"","attributes":[],"text":"\n"},{"kind":"element","parent":15,"name":"p","attributes":[],"text":""},{"kind":"text","parent":20,"name":"","attributes":[],"text":"The seven-person survey team spent three weeks mapping the tidal delta\nwith "},{"kind":"element","parent":20,"name":"a","attributes":[{"name":"href","value":"https://example.com/permits"}],"text":""},{"kind":"text","parent":22,"name":"","attributes":[],"text":"a full research permit"},{"kind":"text","parent":20,"name":"","attributes":[],"text":" in\nhand, recording every transect in careful detail. Progress stayed\n"},{"kind":"element","parent":20,"name":"strong","attributes":[],"text":""},{"kind":"text","parent":25,"name":"","attributes":[],"text":"steady"},{"kind":"text","parent":20,"name":"","attributes":[],"text":" even when the weather turned, and the crew stayed\n"},{"kind":"element","parent":20,"name":"em","attributes":[],"text":""},{"kind":"text","parent":28,"name":"","attributes":[],"text":"focused"},{"kind":"text","parent":20,"name":"","attributes":[],"text":" on finishing the western channel before the spring tides\nreturned."},{"kind":"text","parent":15,"name":"","attributes":[],"text":"\n"},{"kind":"element","parent":15,"name":"h2","attributes":[],"text":""},{"kind":"text","parent":32,"name":"","attributes":[],"text":"Instruments and method"},{"kind":"text","parent":15,"name":"","attributes":[],"text":"\n"},{"kind":"element","parent":15,"name":"p","attributes":[],"text":""},{"kind":"text","parent":35,"name":"","attributes":[],"text":"Two sonar rigs and a hand-held current meter formed the core kit for the\nseason, backed by a paper logbook that every team member signed at the end\nof each shift so nothing was lost between rotations."},{"kind":"text","parent":15,"name":"","attributes":[],"text":"\n"},{"kind":"element","parent":15,"name":"img","attributes":[{"name":"src","value":"https://example.com/images/survey-team.jpg"},{"name":"alt","value":"The survey team wading through the delta at low tide"}],"text":""},{"kind":"text","parent":15,"name":"","attributes":[],"text":"\n"},{"kind":"element","parent":15,"name":"h2","attributes":[],"text":""},{"kind":"text","parent":40,"name":"","attributes":[],"text":"Observations"},{"kind":"text","parent":15,"name":"","attributes":[],"text":"\n"},{"kind":"element","parent":15,"name":"ul","attributes":[],"text":""},{"kind":"text","parent":43,"name":"","attributes":[],"text":"\n"},{"kind":"element","parent":43,"name":"li","attributes":[],"text":""},{"kind":"text","parent":45,"name":"","attributes":[],"text":"Salinity rose sharply above the second channel bend, consistent with\nthe dry-season baseline the team expected going in."},{"kind":"text","parent":43,"name":"","attributes":[],"text":"\n"},{"kind":"element","parent":43,"name":"li","attributes":[],"text":""},{"kind":"text","parent":48,"name":"","attributes":[],"text":"Sediment cores at station four showed three distinct depositional\nlayers, more than any other station sampled this season."},{"kind":"text","parent":43,"name":"","attributes":[],"text":"\n"},{"kind":"text","parent":15,"name":"","attributes":[],"text":"\n"},{"kind":"element","parent":15,"name":"blockquote","attributes":[],"text":""},{"kind":"element","parent":52,"name":"p","attributes":[],"text":""},{"kind":"text","parent":53,"name":"","attributes":[],"text":"The western channel behaves nothing like the model\npredicted, the lead hydrologist wrote in the shared logbook on the\ntwelfth day of the survey."},{"kind":"text","parent":15,"name":"","attributes":[],"text":"\n"},{"kind":"element","parent":15,"name":"h2","attributes":[],"text":""},{"kind":"text","parent":56,"name":"","attributes":[],"text":"Sample readings"},{"kind":"text","parent":15,"name":"","attributes":[],"text":"\n"},{"kind":"element","parent":15,"name":"table","attributes":[],"text":""},{"kind":"text","parent":59,"name":"","attributes":[],"text":"\n"},{"kind":"element","parent":59,"name":"caption","attributes":[],"text":""},{"kind":"text","parent":61,"name":"","attributes":[],"text":"Selected transect depth readings"},{"kind":"text","parent":59,"name":"","attributes":[],"text":"\n"},{"kind":"element","parent":59,"name":"tbody","attributes":[],"text":""},{"kind":"element","parent":64,"name":"tr","attributes":[],"text":""},{"kind":"element","parent":65,"name":"th","attributes":[],"text":""},{"kind":"text","parent":66,"name":"","attributes":[],"text":"Transect"},{"kind":"element","parent":65,"name":"th","attributes":[],"text":""},{"kind":"text","parent":68,"name":"","attributes":[],"text":"Depth (m)"},{"kind":"element","parent":65,"name":"th","attributes":[],"text":""},{"kind":"text","parent":70,"name":"","attributes":[],"text":"Salinity (ppt)"},{"kind":"text","parent":64,"name":"","attributes":[],"text":"\n"},{"kind":"element","parent":64,"name":"tr","attributes":[],"text":""},{"kind":"element","parent":73,"name":"td","attributes":[],"text":""},{"kind":"text","parent":74,"name":"","attributes":[],"text":"1"},{"kind":"element","parent":73,"name":"td","attributes":[],"text":""},{"kind":"text","parent":76,"name":"","attributes":[],"text":"2.1"},{"kind":"element","parent":73,"name":"td","attributes":[],"text":""},{"kind":"text","parent":78,"name":"","attributes":[],"text":"18"},{"kind":"text","parent":64,"name":"","attributes":[],"text":"\n"},{"kind":"element","parent":64,"name":"tr","attributes":[],"text":""},{"kind":"element","parent":81,"name":"td","attributes":[],"text":""},{"kind":"text","parent":82,"name":"","attributes":[],"text":"2"},{"kind":"element","parent":81,"name":"td","attributes":[],"text":""},{"kind":"text","parent":84,"name":"","attributes":[],"text":"1.8"},{"kind":"element","parent":81,"name":"td","attributes":[],"text":""},{"kind":"text","parent":86,"name":"","attributes":[],"text":"22"},{"kind":"text","parent":64,"name":"","attributes":[],"text":"\n"},{"kind":"element","parent":64,"name":"tr","attributes":[],"text":""},{"kind":"element","parent":89,"name":"td","attributes":[],"text":""},{"kind":"text","parent":90,"name":"","attributes":[],"text":"4"},{"kind":"element","parent":89,"name":"td","attributes":[],"text":""},{"kind":"text","parent":92,"name":"","attributes":[],"text":"2.6"},{"kind":"element","parent":89,"name":"td","attributes":[],"text":""},{"kind":"text","parent":94,"name":"","attributes":[],"text":"15"},{"kind":"text","parent":64,"name":"","attributes":[],"text":"\n"},{"kind":"text","parent":15,"name":"","attributes":[],"text":"\n"},{"kind":"element","parent":15,"name":"h2","attributes":[],"text":""},{"kind":"text","parent":98,"name":"","attributes":[],"text":"Data export snippet"},{"kind":"text","parent":15,"name":"","attributes":[],"text":"\n"},{"kind":"element","parent":15,"name":"pre","attributes":[],"text":""},{"kind":"text","parent":101,"name":"","attributes":[],"text":"station,depth_m,salinity_ppt\n1,2.1,18\n2,1.8,22\n4,2.6,15"},{"kind":"text","parent":15,"name":"","attributes":[],"text":"\n"},{"kind":"element","parent":15,"name":"p","attributes":[],"text":""},{"kind":"text","parent":104,"name":"","attributes":[],"text":"Full instrument logs and the complete depth-by-depth dataset are\narchived with the department, which calls it the \"reference dataset\" for\nanyone who wants to reproduce the transect-by-transect salinity curve\ndescribed above in full."},{"kind":"text","parent":15,"name":"","attributes":[],"text":"\n"},{"kind":"text","parent":9,"name":"","attributes":[],"text":"\n"},{"kind":"element","parent":9,"name":"div","attributes":[{"name":"id","value":"comments"},{"name":"class","value":"comments"}],"text":""},{"kind":"text","parent":108,"name":"","attributes":[],"text":"\n"},{"kind":"element","parent":108,"name":"h2","attributes":[],"text":""},{"kind":"text","parent":110,"name":"","attributes":[],"text":"Comments"},{"kind":"text","parent":108,"name":"","attributes":[],"text":"\n"},{"kind":"element","parent":108,"name":"div","attributes":[{"name":"class","value":"commentEntry"}],"text":""},{"kind":"element","parent":113,"name":"div","attributes":[{"name":"class","value":"commentContent"},{"name":"id","value":"comment-101"}],"text":""},{"kind":"text","parent":114,"name":"","attributes":[],"text":"Great\nwriteup -- did the sonar rig need recalibration after the storm on day\nnine?"},{"kind":"text","parent":108,"name":"","attributes":[],"text":"\n"},{"kind":"element","parent":108,"name":"div","attributes":[{"name":"class","value":"commentEntry"}],"text":""},{"kind":"element","parent":117,"name":"div","attributes":[{"name":"class","value":"commentContent"},{"name":"id","value":"comment-102"}],"text":""},{"kind":"text","parent":118,"name":"","attributes":[],"text":"Station\nfour's layering matches what our own team saw further upstream last\nspring."},{"kind":"text","parent":108,"name":"","attributes":[],"text":"\n"},{"kind":"text","parent":9,"name":"","attributes":[],"text":"\n"},{"kind":"element","parent":9,"name":"footer","attributes":[],"text":""},{"kind":"text","parent":122,"name":"","attributes":[],"text":"Copyright 2026 Delta Survey Project. "},{"kind":"element","parent":122,"name":"a","attributes":[{"name":"href","value":"https://example.com/legal"}],"text":""},{"kind":"text","parent":124,"name":"","attributes":[],"text":"Legal"},{"kind":"text","parent":9,"name":"","attributes":[],"text":"\n\n\n"}]}
